{
  "name": "xwh-ai-automation-showcase",
  "version": "1.0.0",
  "private": true,
  "description": "Bilingual synthetic demos for enterprise integration, data automation, and AI support.",
  "scripts": {
    "scan": "python3 scripts/scan-public.py .",
    "scan:public": "python3 scripts/scan-public.py public",
    "build:pages": "node scripts/build-pages.mjs",
    "test:price": "node --test demos/price-console/test/*.test.mjs",
    "test:ai-support": "node --test demos/ai-support/test/*.test.mjs",
    "eval:ai-support": "node demos/ai-support/eval.mjs",
    "test:legacy": "dotnet test demos/legacy-bridge/tests/LegacyBridge.Tests/LegacyBridge.Tests.csproj",
    "test:legacy-preview": "node --test demos/legacy-bridge/tests/web/preview.test.mjs",
    "build:legacy": "dotnet build demos/legacy-bridge/src/LegacyBridge.Api/LegacyBridge.Api.csproj",
    "check:docs": "node scripts/check-docs.mjs",
    "smoke:pages": "node scripts/smoke-pages.mjs",
    "dev": "python3 -m http.server 8770 --bind 127.0.0.1"
  },
  "devDependencies": {
    "playwright": "1.65.1"
  }
}
